{
  "name": "react-project",
  "private": true,
  "version": "0.0.1",
  "packageManager": "npm@11.6.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "server": "node --experimental-strip-types server/index.js",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "icons:generate": "node scripts/generate-pwa-icons.mjs",
    "og:generate": "node scripts/generate-og-images.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "preview": "vite preview",
    "start": "node --experimental-strip-types server/index.js",
    "public": "node scripts/public-run.mjs",
    "public:quick": "node scripts/public-run.mjs --quick",
    "public:stable": "node scripts/public-run.mjs --stable",
    "public:status": "node scripts/public-status.mjs",
    "public:launchd:install": "node scripts/public-launchd-install.mjs",
    "public:launchd:remove": "node scripts/public-launchd-remove.mjs",
    "tunnel:quick": "node scripts/quick-tunnel-5173.mjs",
    "tunnel:notify": "node scripts/notify-tunnel-telegram.mjs",
    "docker:build": "docker compose --env-file .env.docker build",
    "docker:up": "docker compose --env-file .env.docker up --build -d",
    "docker:down": "docker compose --env-file .env.docker down",
    "docker:logs": "docker compose --env-file .env.docker logs -f app",
    "docker:status": "docker compose --env-file .env.docker ps",
    "files:status": "node scripts/files-status.mjs",
    "files:analyze": "node scripts/files-analyze.mjs",
    "files:watch": "node scripts/files-watch.mjs",
    "ollama:pull-glm-ocr": "ollama pull glm-ocr",
    "pdf:md": "node scripts/pdf-to-md.mjs",
    "test": "node --test --experimental-strip-types tests/**/*.test.ts",
    "test:e2e": "playwright test",
    "test:acceptance": "node --experimental-strip-types scripts/quality/gherkin-acceptance.mjs",
    "test:crap": "node scripts/quality/crap-check.mjs",
    "core:test": "cargo test --manifest-path packages/core-rs/Cargo.toml",
    "core:build": "wasm-pack build packages/core-rs --target web --out-dir ../core/wasm --out-name training_core -- --features wasm",
    "test:mutate": "node --experimental-strip-types scripts/quality/mutate-shared.mjs",
    "quality": "node scripts/quality/quality-gate.mjs --tier=a",
    "quality:quick": "node scripts/quality/quality-gate.mjs",
    "audit:prod": "node scripts/quality/audit-prod.mjs",
    "audit:prod:critical": "node scripts/quality/audit-prod.mjs --allow-high",
    "secrets:scan": "gitleaks detect --source . --verbose",
    "seed:journal-demo": "node scripts/seed-journal-demo.mjs",
    "backup": "./scripts/backup.sh",
    "release:pack": "bash scripts/release-pack-lan.sh",
    "release:pack:serve": "bash scripts/release-pack-lan.sh --serve",
    "update:apply": "bash scripts/apply-update-preserve-tunnel.sh",
    "auth:triptych:sync": "node scripts/sync-auth-triptych-public.mjs"
  },
  "dependencies": {
    "@training/core": "0.1.0",
    "@training/shared": "0.1.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.62.1",
    "@types/cors": "^2",
    "@types/express": "^5",
    "@types/jsonwebtoken": "^9",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "autoprefixer": "^10.4.27",
    "eruda": "^3.4.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "framer-motion": "^12.38.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "lucide-react": "^1.23.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.8",
    "postcss-import": "^16.1.1",
    "prettier": "^3.8.3",
    "react": "19.1.0",
    "react-doctor": "^0.5.8",
    "react-dom": "19.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-wasm": "^3.6.0"
  },
  "overrides": {
    "tar": "^7.5.22"
  },
  "allowScripts": {
    "better-sqlite3@12.8.0": true,
    "@swc/core@1.15.41": true,
    "esbuild@0.27.7": true
  }
}
